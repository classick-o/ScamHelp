---
const legalLinks = [
  { label: "Company Registration", href: "https://www.kvk.nl/bestellen/#/78091624000045743274", external: true },
  { label: "Privacy Policy", href: `${import.meta.env.BASE_URL}/privacy-policy` },
  { label: "Terms And Conditions", href: `${import.meta.env.BASE_URL}/terms-and-conditions` },
  { label: "Cookie Policy", href: `${import.meta.env.BASE_URL}/cookie-policy` },
  { label: "Data Protection Addendum", href: `${import.meta.env.BASE_URL}/data-protection-addendum` },
];

const phones = [
  "+31 70 7013260",
  "+1 209 797 7714",
  "+44 16 15286799",
  "+1 647 689 7964",
  "+61 2 7252 2224",
];
---

<footer class="relative pt-16 pb-8 bg-[#0a0a0f] overflow-hidden">

  <div class="absolute bottom-0 left-1/4 w-[500px] h-[500px] bg-[#9ACF84]/2 rounded-full blur-[200px] pointer-events-none"></div>

  <div class="relative z-10 max-w-7xl mx-auto px-6 lg:px-8">

    <!-- Main grid: company | legal | contact -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-10 mb-16">

      <!-- Company info -->
      <div>
        <!-- Logo -->
        <div class="mb-5">
          <img src={`${import.meta.env.BASE_URL}/logo-full.svg`} alt="ScamHelp" class="h-10 w-auto" />
        </div>

        <p class="text-white/25 mb-5" style="font-size:12px;line-height:1.75">
          Scam Help, a service by Transparent Business Solutions B.V., offers free consultations.
          Recovery programs involve applicable retainers, fees, or commissions based on the case.
          Scam Help doesn't provide financial advice or investments. Note for UK residents: We don't
          assist with complaints related to mis-sold investment products regulated by the UK PRA
          and/or FCA. Transparent Business Solutions B.V. is an authorized private investigation
          agency under <a href="#" class="text-[#9ACF84] hover:underline">POB number 07373</a> from
          the Dutch Ministry of Justice and Security.
        </p>

        <!-- Socials -->
        <div class="flex items-center gap-3">
          <a href="https://www.facebook.com/TransparentBusinessSolutions" target="_blank" rel="noopener noreferrer" aria-label="Facebook" class="w-9 h-9 rounded-lg border border-white/10 bg-white/[0.02] flex items-center justify-center text-white/40 hover:text-[#9ACF84] hover:border-[#9ACF84]/30 hover:bg-[#9ACF84]/5 transition-all duration-200">
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
          </a>
          <a href="https://www.linkedin.com/company/scamhelp/" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn" class="w-9 h-9 rounded-lg border border-white/10 bg-white/[0.02] flex items-center justify-center text-white/40 hover:text-[#9ACF84] hover:border-[#9ACF84]/30 hover:bg-[#9ACF84]/5 transition-all duration-200">
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.063 2.063 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
          </a>
          <a href="https://www.trustpilot.com/review/scamhelp.net" target="_blank" rel="noopener noreferrer" aria-label="Trustpilot" class="w-9 h-9 rounded-lg border border-white/10 bg-white/[0.02] flex items-center justify-center text-white/40 hover:text-[#9ACF84] hover:border-[#9ACF84]/30 hover:bg-[#9ACF84]/5 transition-all duration-200">
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M12 17.964l5.214-1.321L19.4 23.4 12 17.964zM24 9.164h-9.184L12 .6 9.184 9.164H0l7.43 5.302-2.815 8.564 7.43-5.302 4.572-3.262L24 9.164z"/></svg>
          </a>
        </div>
      </div>

      <!-- Legal Documents -->
      <div>
        <h4 class="text-white mb-1" style="font-family:'Montserrat',sans-serif;font-size:15px;font-weight:700">
          Legal Documents
        </h4>
        <div class="w-10 h-0.5 bg-[#9ACF84] mb-5"></div>
        <ul class="space-y-3">
          {legalLinks.map((link) => (
            <li>
              <a
                href={link.href}
                target={link.external ? "_blank" : undefined}
                rel={link.external ? "noopener noreferrer" : undefined}
                class="text-white/50 hover:text-[#9ACF84] transition-colors duration-200 underline underline-offset-2"
                style="font-size:13px"
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Contact Info -->
      <div>
        <h4 class="text-white mb-1" style="font-family:'Montserrat',sans-serif;font-size:15px;font-weight:700">
          Contact Info
        </h4>
        <div class="w-10 h-0.5 bg-[#9ACF84] mb-5"></div>
        <div class="space-y-4">
          <!-- Address -->
          <div class="flex items-start gap-2.5">
            <svg class="w-4 h-4 text-[#9ACF84] flex-shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
            <span class="text-white/45" style="font-size:13px;line-height:1.6">Kalvermarkt 53, 2511 CB,<br/>The Hague, Netherlands</span>
          </div>
          <!-- Email -->
          <div class="flex items-center gap-2.5">
            <svg class="w-4 h-4 text-[#9ACF84] flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
            <span class="text-white/45" style="font-size:13px">support@scamhelp.net</span>
          </div>
          <!-- Phones -->
          <div class="flex items-start gap-2.5">
            <svg class="w-4 h-4 text-[#9ACF84] flex-shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
            </svg>
            <div class="grid grid-cols-2 gap-x-4 gap-y-1">
              {phones.map((p) => (
                <span class="text-white/45" style="font-size:13px">{p}</span>
              ))}
            </div>
          </div>
        </div>
      </div>

    </div>

    <!-- Bottom bar -->
    <div class="pt-6 border-t border-white/5 text-center">
      <p class="text-white/15" style="font-size:12px">
        &copy; 2026 Scam Help. All rights reserved.
      </p>
    </div>

  </div>
</footer>
