---
const base = import.meta.env.BASE_URL;
const navLinks = [
  { label: "About us",         href: `${base}/about`    },
  { label: "Know your rights", href: `${base}/rights`   },
  { label: "Common Scams",     href: `${base}/scams`    },
  { label: "Our Partners",     href: `${base}/partners` },
  { label: "Services",         href: `${base}/services` },
  { label: "News",             href: `${base}/news`     },
];
---

<nav id="navbar" class="fixed top-0 left-0 right-0 z-50">
  <div class="max-w-7xl mx-auto px-6 lg:px-8">
    <div class="flex items-center justify-between h-[56px] lg:h-[72px]">

      <!-- Logo -->
      <a href={base} class="btn-scale flex items-center">
        <img src={`${import.meta.env.BASE_URL}/logo_simple.svg`} alt="ScamHelp" class="w-7 lg:w-auto lg:h-9" />
      </a>

      <!-- Desktop Nav -->
      <div class="hidden lg:flex items-center gap-0.5">
        {navLinks.map((link) => (
          <div class={link.children ? "nav-dropdown" : "relative"}>
            <a
              href={link.href}
              class="px-3.5 py-2 text-white hover:text-white/80 transition-colors duration-200 flex items-center gap-1"
              style="font-family:'Montserrat',sans-serif;font-size:13px;font-weight:500"
            >
              {link.label}
              {link.children && (
                <svg class="w-3 h-3 opacity-50" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
                </svg>
              )}
            </a>
            {link.children && (
              <div class="nav-dropdown-menu">
                {link.children.map((child) => (
                  <a
                    href={child.href}
                    class="block px-3.5 py-2.5 text-white/50 hover:text-white hover:bg-white/5 rounded-lg transition-all duration-150"
                    style="font-family:'Montserrat',sans-serif;font-size:13px"
                  >
                    {child.label}
                  </a>
                ))}
              </div>
            )}
          </div>
        ))}
      </div>

      <!-- CTA Desktop -->
      <div class="hidden lg:block">
        <a
          href="#consultation"
          class="btn-scale inline-flex items-center px-5 py-2 bg-[#9ACF84] text-[#0a0a0f] rounded-lg hover:bg-[#8BC275] transition-colors duration-200"
          style="font-family:'Montserrat',sans-serif;font-size:13px;font-weight:600"
        >
          Free Consultation
        </a>
      </div>

      <!-- Mobile Toggle -->
      <button id="mobile-toggle" class="lg:hidden text-white p-2 -mr-2" aria-label="Toggle menu">
        <!-- Menu icon -->
        <svg id="icon-menu" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        <!-- Close icon -->
        <svg id="icon-close" class="w-5 h-5 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Menu -->
  <div id="mobile-menu" class="lg:hidden border-t border-white/5">
    <div class="px-6 py-5 space-y-0.5">
      {navLinks.map((link) => (
        <div>
          <a
            href={link.href}
            class="mobile-link block py-3 text-white transition-colors"
            style="font-family:'Montserrat',sans-serif;font-size:15px;font-weight:500"
          >
            {link.label}
          </a>
          {link.children && (
            <div class="pl-4 space-y-0.5 mb-1">
              {link.children.map((child) => (
                <a
                  href={child.href}
                  class="mobile-link block py-2 text-white/35 hover:text-[#9ACF84] transition-colors"
                  style="font-family:'Montserrat',sans-serif;font-size:13px"
                >
                  {child.label}
                </a>
              ))}
            </div>
          )}
        </div>
      ))}
      <div class="pt-4">
        <a
          href="#consultation"
          class="mobile-link block text-center px-5 py-3 bg-[#9ACF84] text-[#0a0a0f] rounded-lg"
          style="font-family:'Montserrat',sans-serif;font-size:14px;font-weight:600;box-shadow:0 4px 20px rgba(154,207,132,0.45), 0 2px 8px rgba(0,0,0,0.3)"
        >
          Free Consultation
        </a>
      </div>

      <!-- Socials -->
      <div class="flex items-center justify-center gap-3 pt-5">
        <a href="https://www.facebook.com/TransparentBusinessSolutions" target="_blank" rel="noopener noreferrer" aria-label="Facebook" class="w-10 h-10 rounded-lg border border-white/10 bg-white/[0.02] flex items-center justify-center text-white/40 hover:text-[#9ACF84] hover:border-[#9ACF84]/30 hover:bg-[#9ACF84]/5 transition-all duration-200">
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
        </a>
        <a href="https://www.linkedin.com/company/scamhelp/" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn" class="w-10 h-10 rounded-lg border border-white/10 bg-white/[0.02] flex items-center justify-center text-white/40 hover:text-[#9ACF84] hover:border-[#9ACF84]/30 hover:bg-[#9ACF84]/5 transition-all duration-200">
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.063 2.063 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
        </a>
        <a href="https://www.trustpilot.com/review/scamhelp.net" target="_blank" rel="noopener noreferrer" aria-label="Trustpilot" class="w-10 h-10 rounded-lg border border-white/10 bg-white/[0.02] flex items-center justify-center text-white/40 hover:text-[#9ACF84] hover:border-[#9ACF84]/30 hover:bg-[#9ACF84]/5 transition-all duration-200">
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M12 17.964l5.214-1.321L19.4 23.4 12 17.964zM24 9.164h-9.184L12 .6 9.184 9.164H0l7.43 5.302-2.815 8.564 7.43-5.302 4.572-3.262L24 9.164z"/></svg>
        </a>
      </div>
    </div>
  </div>
</nav>

<!-- Mobile menu backdrop overlay -->
<div id="mobile-menu-overlay" class="lg:hidden fixed inset-0 z-40 bg-black/65 opacity-0 pointer-events-none transition-opacity duration-300" aria-hidden="true"></div>

<!-- Navbar entry animation -->
<style>
  #navbar {
    animation: nav-enter 0.8s cubic-bezier(0.22, 1, 0.36, 1) both;
  }
  @keyframes nav-enter {
    from { transform: translateY(-100%); opacity: 0; }
    to   { transform: translateY(0);     opacity: 1; }
  }
  #mobile-menu-overlay.visible {
    opacity: 1;
    pointer-events: auto;
  }
</style>

<script>
  // Scroll detection
  const navbar = document.getElementById('navbar');
  window.addEventListener('scroll', () => {
    if (window.scrollY > 50) {
      navbar?.classList.add('scrolled');
    } else {
      navbar?.classList.remove('scrolled');
    }
  }, { passive: true });

  // Mobile toggle
  const toggle    = document.getElementById('mobile-toggle');
  const menu      = document.getElementById('mobile-menu');
  const iconMenu  = document.getElementById('icon-menu');
  const iconClose = document.getElementById('icon-close');
  const overlay   = document.getElementById('mobile-menu-overlay');

  function closeMenu() {
    menu?.classList.remove('open');
    iconMenu?.classList.remove('hidden');
    iconClose?.classList.add('hidden');
    overlay?.classList.remove('visible');
  }

  function openMenu() {
    menu?.classList.add('open');
    iconMenu?.classList.add('hidden');
    iconClose?.classList.remove('hidden');
    overlay?.classList.add('visible');
  }

  toggle?.addEventListener('click', () => {
    const isOpen = menu?.classList.contains('open');
    if (isOpen) closeMenu(); else openMenu();
  });

  overlay?.addEventListener('click', closeMenu);

  // Close mobile menu on link click
  document.querySelectorAll('.mobile-link').forEach((link) => {
    link.addEventListener('click', closeMenu);
  });
</script>
